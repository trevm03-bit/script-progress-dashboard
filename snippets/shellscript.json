{
  "Script Progress: shell script run": {
    "prefix": "prog-cli",
    "description": "Report a shell script to the dashboard. One run across many commands; the trap reports an abort.",
    "body": [
      "PROGRESS=\"${1:scripts/lib/progress.py}\"",
      "export PROGRESS_TASK=\"${2:Nightly Job}\"",
      "",
      "# complete on an already-finished run is a no-op, so this is safe to arm immediately.",
      "trap 'python \"\\$PROGRESS\" complete --fail --summary \"aborted\"' EXIT",
      "",
      "python \"\\$PROGRESS\" start --total 3",
      "",
      "python \"\\$PROGRESS\" step 1 3 \"${3:Fetching}\"",
      "${4:# ... work ...}",
      "",
      "python \"\\$PROGRESS\" step 2 3 \"${5:Processing}\"",
      "python \"\\$PROGRESS\" metric ${6:rows} \"$${7:COUNT}\"",
      "",
      "python \"\\$PROGRESS\" step 3 3 \"${8:Finishing}\"",
      "trap - EXIT",
      "python \"\\$PROGRESS\" complete --summary \"${9:done}\"",
      ""
    ]
  }
}
