{
  "Script Progress: PowerShell script run": {
    "prefix": "prog-cli",
    "description": "Report a PowerShell script to the dashboard. One run across many commands; the finally block reports an abort.",
    "body": [
      "\\$Progress = \"${1:scripts/lib/progress.py}\"",
      "\\$env:PROGRESS_TASK = \"${2:Nightly Job}\"",
      "",
      "try {",
      "    python \\$Progress start --total 3",
      "",
      "    python \\$Progress step 1 3 \"${3:Fetching}\"",
      "    ${4:# ... work ...}",
      "",
      "    python \\$Progress step 2 3 \"${5:Processing}\"",
      "    python \\$Progress metric ${6:rows} \\$${7:Count}",
      "",
      "    python \\$Progress step 3 3 \"${8:Finishing}\"",
      "    python \\$Progress complete --summary \"${9:done}\"",
      "}",
      "catch {",
      "    # --fail records the run as failed, with the reason, instead of leaving it 'running'.",
      "    python \\$Progress complete --fail --summary \"\\$(\\$_.Exception.Message)\"",
      "    throw",
      "}",
      "$0"
    ]
  }
}
